<?xml version="1.0" encoding="utf-8"?>
<!-- Listas IPTV costumam usar http:// — por isso o tráfego sem TLS é permitido. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
